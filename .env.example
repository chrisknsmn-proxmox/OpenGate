# Copy to .env (never commit .env). Generate the key with:
#   openssl rand -base64 48 | tr -d '\n=+/'
OPENGATE_API_KEY=replace-with-long-random-value

# Required: where Ollama runs, and which installed model to serve.
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.1:8b

# Optional (defaults shown).
OPENGATE_VIRTUAL_MODEL=opengate/local
OPENGATE_HOST=0.0.0.0
OPENGATE_PORT=8000
UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
UPSTREAM_REQUEST_TIMEOUT_SECONDS=120
UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REQUESTS=2
RUST_LOG=info
LOG_PROMPT_CONTENT=false

# Wake-on-LAN for the Ollama PC. Off unless WOL_ENABLED=true. When enabled,
# values must be valid or OpenGate refuses to start; if the MAC or the
# destination is missing, WOL stays disabled (with a warning).
WOL_ENABLED=false
WOL_MAC_ADDRESS=AA:BB:CC:DD:EE:64
WOL_BROADCAST_ADDRESS=192.168.1.255
WOL_PORT=9
WOL_STARTUP_TIMEOUT_SECONDS=90
WOL_POLL_INTERVAL_SECONDS=3
# After a failed wake, requests fail fast with 503 for this long.
WOL_RETRY_COOLDOWN_SECONDS=30
# In Docker (bridge network) broadcasts do not reach the LAN: run the relay
# (compose.wol-relay.yaml) and point OpenGate at it. Takes precedence over
# WOL_BROADCAST_ADDRESS. Leave empty when running directly on the host.
WOL_RELAY_ADDRESS=
# Relay side only: where `opengate wol-relay` listens (host network).
WOL_RELAY_LISTEN=172.17.0.1:9009
