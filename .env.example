# Copy to .env (never commit .env). Generate the key with:
#   openssl rand -base64 48 | tr -d '\n=+/'
OPENGATE_API_KEY=replace-with-long-random-value

# Required: where Ollama runs, and which installed model to serve.
OLLAMA_BASE_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.1:8b

# Optional (defaults shown).
OPENGATE_VIRTUAL_MODEL=opengate/local
OPENGATE_HOST=0.0.0.0
OPENGATE_PORT=8000
UPSTREAM_CONNECT_TIMEOUT_SECONDS=3
UPSTREAM_REQUEST_TIMEOUT_SECONDS=120
UPSTREAM_STREAM_IDLE_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REQUESTS=2
RUST_LOG=info
LOG_PROMPT_CONTENT=false
