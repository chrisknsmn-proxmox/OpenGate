# Reviewed exceptions for .githooks/scan-secrets.sh. Keep this short.
# path:<exact repo path>     skip that file's contents and file-name check
# literal:<string>           skip added lines containing this exact string

# Throwaway RSA key that signs mock ID tokens in tests (tests/fixtures/README.md).
path:tests/fixtures/test_id_token_key.pem
# Fake key used to assert OpenGate never forwards an OpenAI API key.
literal:sk-proj-must-never-be-sent
# systemd unit: the path of the token file, not a token.
literal:LoadCredential=coolify-token:/etc/opengate-autodeploy/coolify-token
